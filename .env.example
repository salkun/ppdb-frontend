# ========================================================
# PPDB SMPS 2 AL-MUHAJIRIN - ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. APPLICATION & SECURITY SETTINGS
# --------------------------------------------------------
APP_NAME="PPDB SMPS 2 Al-Muhajirin"

# PENTING: Di server live / production, set APP_ENV=production dan APP_DEBUG=false.
# Membiarkan APP_DEBUG=true di production akan mengekspos credential dan detail query ke publik!
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --------------------------------------------------------
# 2. LOCAL DATABASE (HYBRID SOURCE OF TRUTH)
# --------------------------------------------------------
# PENTING SECURITY:
# - Di server produksi, JANGAN gunakan user 'root' tanpa password.
# - Buat user MySQL tersendiri dengan izin terbatas (SELECT, INSERT, UPDATE, DELETE, INDEX, ALTER, CREATE).
# - Pastikan port 3306 MySQL hanya mendengarkan di 127.0.0.1 (bind-address = 127.0.0.1) dan ditutup firewall publik.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppdb_db
DB_USERNAME=ppdb_user
DB_PASSWORD=your_strong_db_password

# --------------------------------------------------------
# 3. SESSION & COOKIE HARDENING
# --------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="ppdb@example.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --------------------------------------------------------
# 4. REMOTE BACKEND API & NOTIFIKASI
# --------------------------------------------------------
API_BACKEND_URL=http://127.0.0.1:8001

# Telegram Bot Panitia PPDB
# Dapatkan Token dari @BotFather dan Chat ID Grup Panitia dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_PANITIA_CHAT_ID=
